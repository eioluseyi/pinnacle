{
  "name": "@pinnacle/desktop",
  "productName": "Pinnacle",
  "description": "Web view addon for your projection software",
  "version": "0.1.13",
  "private": true,
  "main": "dist-electron/main.js",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/eioluseyi/pinnacle.git"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "dev": "yarn build:electron && electron .",
    "build:electron": "node build-electron.mjs",
    "build": "yarn build:electron",
    "start:prod": "cross-env NODE_ENV=production electron dist-electron/main.js",
    "package": "yarn build:electron && dotenv -e ../../.env -- electron-forge package",
    "publish": "yarn build:electron && dotenv -e ../../.env -- electron-forge publish",
    "lint": "eslint ."
  },
  "dependencies": {
    "@pinnacle/server": "*",
    "@types/electron-squirrel-startup": "^1.0.2",
    "electron-squirrel-startup": "^1.0.1",
    "update-electron-app": "^3.3.0"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.11.2",
    "@electron-forge/maker-dmg": "^7.11.2",
    "@electron-forge/publisher-github": "^7.11.2",
    "electron": "^43.1.0",
    "esbuild": "^0.20.0"
  },
  "license": "MIT"
}

{
  "name": "@pinnacle/desktop",
  "productName": "Pinnacle",
  "description": "Web view addon for your projection software",
  "version": "0.1.15",
  "private": true,
  "main": "dist/electron/main.js",
  "type": "commonjs",
  "repository": {
    "type": "git",
    "url": "https://github.com/eioluseyi/pinnacle.git"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "dev": "yarn build:electron && electron .",
    "build:electron": "node build-electron.mjs",
    "build": "yarn build:electron",
    "make": "cross-env NODE_ENV=production DEBUG=electron-forge:* NODE_OPTIONS=\"--trace-warnings --trace-uncaught\" electron-forge make",
    "publish": "electron-forge publish",
    "bump": "yarn version --patch",
    "postversion": "git push && git push --tags",
    "lint": "eslint ."
  },
  "dependencies": {
    "electron-squirrel-startup": "^1.0.1",
    "update-electron-app": "^3.3.0"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.11.2",
    "@electron-forge/maker-deb": "^7.11.2",
    "@electron-forge/maker-dmg": "^7.11.2",
    "@electron-forge/maker-rpm": "^7.11.2",
    "@electron-forge/maker-squirrel": "^7.11.2",
    "@electron-forge/maker-zip": "^7.11.2",
    "@electron-forge/plugin-auto-unpack-natives": "^7.11.2",
    "@electron-forge/plugin-fuses": "^7.11.2",
    "@electron-forge/publisher-github": "^7.11.2",
    "@electron/fuses": "^2.1.3",
    "@types/electron-squirrel-startup": "^1.0.2",
    "electron": "^43.1.0",
    "esbuild": "^0.20.0"
  },
  "author": "Emmanuel (EIO) Imolorhe | @eioluseyi <eioluseyi@gmail.com> (https://eioluseyi.com)",
  "homepage": "https://pinnacle.eioluseyi.com",
  "bugs": {
    "url": "https://github.com/eioluseyi/pinnacle/issues",
    "email": "eioluseyi@gmail.com"
  },
  "funding": {
    "type": "patreon",
    "url": "https://www.patreon.com/13160342/join"
  },
  "license": "MIT",
  "keywords": [
    "desktop-app",
    "electron",
    "nextjs",
    "cross-platform",
    "nodejs",
    "websocket",
    "monorepo",
    "local-first",
    "pinnacle",
    "uk-software",
    "british-tech",
    "nigerian-software",
    "nigerian-tech",
    "desktop-utility"
  ]
}

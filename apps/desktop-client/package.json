{
  "name": "@pinnacle/desktop-client",
  "productName": "Pinnacle client",
  "description": "Client app to make Pinnacle app use smoother",
  "version": "1.0.3",
  "private": false,
  "main": "dist/electron/main.cjs",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/eioluseyi/pinnacle.git"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "dev:client": "yarn build:electron && electron .",
    "dev:client-web": "yarn next dev --port 3005",
    "build:electron": "node build-electron.mjs",
    "build:client": "yarn next build && yarn build:electron",
    "make": "cross-env NODE_ENV=production DEBUG=electron-forge:* NODE_OPTIONS=\"--trace-warnings --trace-uncaught\" electron-forge make",
    "publish": "electron-forge publish",
    "bump": "yarn version --patch --no-git-tag-version",
    "bump-minor": "yarn version --minor --no-git-tag-version",
    "bump-major": "yarn version --major --no-git-tag-version",
    "ver": "node -p \"require('./package.json').version\"",
    "rm-tag": "git tag -d \"v$(yarn -s ver)\" 2>/dev/null || true",
    "commit": "git add package.json && git commit -m \"Release desktop-client v$(yarn -s ver)\"",
    "mk-tag": "v=$(yarn -s ver) && git tag -a \"desktop-client-v$v\" -m \"Release desktop-client v$v\"",
    "push-br": "git push origin HEAD",
    "push-tag": "git push origin \"desktop-client-v$(yarn -s ver)\"",
    "postversion": "yarn rm-tag && yarn commit && yarn mk-tag && yarn push-br && yarn push-tag",
    "lint": "eslint ."
  },
  "dependencies": {
    "electron-squirrel-startup": "^1.0.1",
    "node-syphon": "^1.0.0",
    "update-electron-app": "^3.3.0"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.11.2",
    "@electron-forge/maker-deb": "^7.11.2",
    "@electron-forge/maker-dmg": "^7.11.2",
    "@electron-forge/maker-rpm": "^7.11.2",
    "@electron-forge/maker-squirrel": "^7.11.2",
    "@electron-forge/maker-zip": "^7.11.2",
    "@electron-forge/plugin-auto-unpack-natives": "^7.11.2",
    "@electron-forge/plugin-fuses": "^7.11.2",
    "@electron-forge/publisher-github": "^7.11.2",
    "@electron/fuses": "^2.1.3",
    "@pinnacle/utils": "*",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/electron-squirrel-startup": "^1.0.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "electron": "^43.1.0",
    "esbuild": "^0.20.0",
    "next": "^16.3.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.3"
  },
  "author": "Emmanuel (EIO) Imolorhe | @eioluseyi <eioluseyi@gmail.com> (https://eioluseyi.com)",
  "homepage": "https://pinnacle.eioluseyi.com",
  "bugs": {
    "url": "https://github.com/eioluseyi/pinnacle/issues",
    "email": "eioluseyi@gmail.com"
  },
  "funding": {
    "type": "patreon",
    "url": "https://www.patreon.com/13160342/join"
  },
  "license": "MIT",
  "keywords": [
    "desktop-app",
    "electron",
    "nextjs",
    "cross-platform",
    "nodejs",
    "websocket",
    "monorepo",
    "local-first",
    "pinnacle",
    "uk-software",
    "british-tech",
    "nigerian-software",
    "nigerian-tech",
    "desktop-utility"
  ]
}

{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "incremental": true,
    "noEmit": true,
    "rootDir": "."
  },
  "exclude": ["node_modules", "dist", "out", "dist/next", "**/*.config.js", "**/*.config.mjs"]
}

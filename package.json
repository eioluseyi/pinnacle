{
  "name": "pinnacle-monorepo",
  "private": true,
  "packageManager": "yarn@1.22.22",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "dev:web-app": "turbo run dev --filter=web-app --filter=@pinnacle/server",
    "dev:desktop": "turbo run dev --filter=desktop",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "clean": "rm -rf node_modules || rm -rf apps/desktop/dist-electron || rm -rf apps/desktop/node_modules || rm -rf apps/web-app/next-out || rm -rf apps/web-app/node_modules || rm -rf packages/server/node_modules"
  },
  "devDependencies": {
    "turbo": "^2.0.0",
    "concurrently": "^9.2.1"
  },
  "license": "MIT"
}

{
  "name": "pinnacle-monorepo",
  "private": true,
  "packageManager": "yarn@1.22.22",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "dev:web-app": "turbo run dev --filter=@pinnacle/web-app --filter=@pinnacle/server",
    "dev:desktop": "yarn build:web && turbo run start:prod --filter=@pinnacle/desktop",
    "build:web": "turbo run build --filter=@pinnacle/web-app --filter=@pinnacle/server",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "clean": "rm -rf node_modules || rm -rf apps/desktop/dist/electron || rm -rf apps/desktop/node_modules || rm -rf apps/web-app/dist/next || rm -rf apps/web-app/node_modules || rm -rf packages/server/node_modules || rm -rf apps/web-app/public/bucket"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "eslint": "^10.8.1",
    "eslint-config-next": "^16.3.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "turbo": "^2.0.0",
    "typescript-eslint": "^8.67.0"
  },
  "license": "MIT"
}

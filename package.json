{
  "name": "pinnacle",
  "version": "0.1.0",
  "private": true,
  "main": "main.js",
  "type": "module",
  "scripts": {
    "socket": "tsx socket-server/server.ts",
    "dev": "concurrently -k -n socket,next -c blue,green \"yarn socket\" \"wait-on tcp:localhost:1234 && next dev\"",
    "build": "next build",
    "next-start": "concurrently -k -n socket,next -c blue,green \"yarn socket\" \"wait-on tcp:localhost:1234 && next start\"",
    "lint": "eslint",
    "electron": "electron ."
  },
  "author": "Emmanuel (EIO) Imolorhe | @eioluseyi",
  "license": "MIT",
  "dependencies": {
    "@types/express": "^5.0.6",
    "classnames": "^2.5.1",
    "express": "^5.2.1",
    "lucide-react": "^1.23.0",
    "next": "16.2.10",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^9.2.1",
    "electron": "^43.1.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "tailwindcss": "^4",
    "tsx": "^4.20.3",
    "typescript": "^5",
    "wait-on": "^8.0.4"
  }
}
